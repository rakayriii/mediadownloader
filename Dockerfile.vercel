# Dockerfile.vercel - Vercel Container Deployment
# Installs yt-dlp and FFmpeg inside the container for production use.
# Local development continues to work via config.ts resolution logic.
#
# Base: Debian slim (NOT Alpine). Prisma 5's musl query engine links against
# libssl.so.1.1, which modern Alpine (OpenSSL 3) no longer ships; on Debian the
# engine resolves against OpenSSL 3.0 and loads cleanly.

FROM node:22-slim AS base

# System dependencies: yt-dlp, ffmpeg, python3, ca-certificates
# yt-dlp is PINNED to the version that was validated locally (2026.08.19).
# Unpinned installs drift with whatever pip resolves at build time, which
# quietly changes extractor behavior (especially TikTok/Instagram, which
# change their anti-bot responses often) between local and deployed runs.
# Bump deliberately + verify TikTok/IG analyze locally before committing.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-pip \
        ffmpeg \
        ca-certificates \
    && pip3 install --no-cache-dir --break-system-packages "yt-dlp==2026.08.19" \
    && yt-dlp --version \
    && ffmpeg -version \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install ALL dependencies (including devDependencies needed for build)
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY . .
# Generate the Prisma client. "npm ci" ran before schema.prisma existed in the
# layer (it is copied by COPY . .), so the postinstall auto-generation skipped;
# without this, @prisma/client types are missing and the build type-check fails
# with TS7006 implicit-any errors in src/lib/db.ts.
RUN npx prisma generate && npm run build

# Copy Next.js standalone output to app root for runtime
# Standalone output includes: server.js, .next/ (static + server), node_modules/
RUN cp -r .next/standalone/* . && \
    mkdir -p .next && \
    cp -r .next/static .next/ && \
    cp -r public .next/ 2>/dev/null || true

# Create non-root user for security (Vercel runs as non-root)
RUN groupadd -g 1001 nodejs && \
    useradd -g nodejs -u 1001 -m nextjs

# Create data directories with proper permissions
RUN mkdir -p .mediavault/downloads .mediavault/temp .mediavault/thumbnails && \
    chown -R nextjs:nodejs .mediavault

USER nextjs

# Vercel Container provides $PORT at runtime
EXPOSE 3000

ENV HOSTNAME="0.0.0.0"
# PORT is set by Vercel at runtime, do not hardcode

CMD ["node", "server.js"]